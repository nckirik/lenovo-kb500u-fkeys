# KB500U top row -> F1-F8 on the local X11 display.
# Applied by x11/with-keymap.sh or x11-keymap hold.
keycode 121 = F1 F1 F1 F1   # Silent
keycode 122 = F2 F2 F2 F2   # Volume Down
keycode 123 = F3 F3 F3 F3   # Volume Up
keycode 248 = F4 F4 F4 F4   # Mic Mute
keycode 232 = F5 F5 F5 F5   # Brightness Down
keycode 233 = F6 F6 F6 F6   # Brightness Up
keycode 199 = F7 F7 F7 F7   # Trackpad
keycode 107 = F8 F8 F8 F8   # Capture Screen
