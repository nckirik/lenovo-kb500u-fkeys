type OVERLAY

# Lenovo KB500U top row -> F1..F12, plus Home/End for AI/App.
#
# Plain press (with or without Shift) sends the F key, or Home/End
# for the AI and App keys. Home/End means MOVE_HOME/MOVE_END, the
# text-editing keys, not the Android Home button.
#
# Any press containing Ctrl, Alt or Meta sends the original Lenovo
# key instead, with every modifier in the combination stripped,
# including Shift. This keeps the original action available on
# combinations such as Ctrl+Meta+Alt+key.
#
# Escape and Delete are deliberately left untouched.

# Silent
key LENOVO_VOLUME_MUTE {
    base: replace F1
    ctrl+alt+meta+shift: replace LENOVO_VOLUME_MUTE
    ctrl+alt+shift: replace LENOVO_VOLUME_MUTE
    ctrl+meta+shift: replace LENOVO_VOLUME_MUTE
    alt+meta+shift: replace LENOVO_VOLUME_MUTE
    ctrl+shift: replace LENOVO_VOLUME_MUTE
    alt+shift: replace LENOVO_VOLUME_MUTE
    meta+shift: replace LENOVO_VOLUME_MUTE
    ctrl+alt+meta: replace LENOVO_VOLUME_MUTE
    ctrl+alt: replace LENOVO_VOLUME_MUTE
    ctrl+meta: replace LENOVO_VOLUME_MUTE
    alt+meta: replace LENOVO_VOLUME_MUTE
    ctrl: replace LENOVO_VOLUME_MUTE
    alt: replace LENOVO_VOLUME_MUTE
    meta: replace LENOVO_VOLUME_MUTE
}

# Volume Down
key VOLUME_DOWN {
    base: replace F2
    ctrl+alt+meta+shift: replace VOLUME_DOWN
    ctrl+alt+shift: replace VOLUME_DOWN
    ctrl+meta+shift: replace VOLUME_DOWN
    alt+meta+shift: replace VOLUME_DOWN
    ctrl+shift: replace VOLUME_DOWN
    alt+shift: replace VOLUME_DOWN
    meta+shift: replace VOLUME_DOWN
    ctrl+alt+meta: replace VOLUME_DOWN
    ctrl+alt: replace VOLUME_DOWN
    ctrl+meta: replace VOLUME_DOWN
    alt+meta: replace VOLUME_DOWN
    ctrl: replace VOLUME_DOWN
    alt: replace VOLUME_DOWN
    meta: replace VOLUME_DOWN
}

# Volume Up
key VOLUME_UP {
    base: replace F3
    ctrl+alt+meta+shift: replace VOLUME_UP
    ctrl+alt+shift: replace VOLUME_UP
    ctrl+meta+shift: replace VOLUME_UP
    alt+meta+shift: replace VOLUME_UP
    ctrl+shift: replace VOLUME_UP
    alt+shift: replace VOLUME_UP
    meta+shift: replace VOLUME_UP
    ctrl+alt+meta: replace VOLUME_UP
    ctrl+alt: replace VOLUME_UP
    ctrl+meta: replace VOLUME_UP
    alt+meta: replace VOLUME_UP
    ctrl: replace VOLUME_UP
    alt: replace VOLUME_UP
    meta: replace VOLUME_UP
}

# Mic Mute
key MUTE {
    base: replace F4
    ctrl+alt+meta+shift: replace MUTE
    ctrl+alt+shift: replace MUTE
    ctrl+meta+shift: replace MUTE
    alt+meta+shift: replace MUTE
    ctrl+shift: replace MUTE
    alt+shift: replace MUTE
    meta+shift: replace MUTE
    ctrl+alt+meta: replace MUTE
    ctrl+alt: replace MUTE
    ctrl+meta: replace MUTE
    alt+meta: replace MUTE
    ctrl: replace MUTE
    alt: replace MUTE
    meta: replace MUTE
}

