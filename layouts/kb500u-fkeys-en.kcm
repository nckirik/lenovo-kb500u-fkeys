# Lenovo Smart Key (AI)
key APP1 {
    base: replace MOVE_HOME
    ctrl+alt+meta+shift: replace APP1
    ctrl+alt+shift: replace APP1
    ctrl+meta+shift: replace APP1
    alt+meta+shift: replace APP1
    ctrl+shift: replace APP1
    alt+shift: replace APP1
    meta+shift: replace APP1
    ctrl+alt+meta: replace APP1
    ctrl+alt: replace APP1
    ctrl+meta: replace APP1
    alt+meta: replace APP1
    ctrl: replace APP1
    alt: replace APP1
    meta: replace APP1
}

# App to Customize
key APP2 {
    base: replace MOVE_END
    ctrl+alt+meta+shift: replace APP2
    ctrl+alt+shift: replace APP2
    ctrl+meta+shift: replace APP2
    alt+meta+shift: replace APP2
    ctrl+shift: replace APP2
    alt+shift: replace APP2
    meta+shift: replace APP2
